# Copy to .env and fill in ONE of these. Whichever key is configured is the provider
# that gets used — run `npx tsx packages/robot/src/cli.ts providers` to confirm which.
#
# Only divergence, synth, adjudicate and explore need a key. surface, run and eval
# work entirely offline.

# Google Gemini
# GEMINI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Force a provider when both keys are present, or pin a specific model.
# ROBOT_PROVIDER=gemini
# ROBOT_MODEL=gemini-2.5-pro
